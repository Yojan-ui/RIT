{
  "_comment": "End-to-end scan scenarios. 'smtp' selects the mocked transport behaviour: 'no_starttls' (MX answers without STARTTLS), 'tls13' (modern TLS, valid certificate), 'port25_blocked' (MX and the reference egress host both refuse connections).",
  "unprotected": {
    "domain": "unprotected.test",
    "dkim_selectors": [
      "default"
    ],
    "smtp": "no_starttls",
    "zone": {
      "unprotected.test": {
        "MX": [
          "10 mx.unprotected.test"
        ],
        "TXT": [
          "google-site-verification=xyz"
        ]
      }
    },
    "http": {},
    "expected": {
      "grade": "F",
      "statuses": {
        "mx": "pass",
        "spf": "missing",
        "dkim": "missing",
        "dmarc": "missing",
        "mta_sts": "missing",
        "tls_rpt": "missing",
        "transport": "fail"
      },
      "not_assessed": [],
      "exposure": {
        "direct-spoofing": "exposed",
        "subdomain-spoofing": "exposed",
        "envelope-spoofing": "exposed",
        "unsigned-mail": "exposed",
        "tls-downgrade": "exposed",
        "plaintext-interception": "exposed",
        "undetected-abuse": "exposed"
      },
      "one_fix": "dmarc"
    }
  },
  "hardened": {
    "domain": "hardened.test",
    "dkim_selectors": [
      "s2048"
    ],
    "smtp": "tls13",
    "zone": {
      "hardened.test": {
        "MX": [
          "10 mx1.hardened.test"
        ],
        "TXT": [
          "v=spf1 ip4:192.0.2.10 -all"
        ]
      },
      "_dmarc.hardened.test": {
        "TXT": [
          "v=DMARC1; p=reject; rua=mailto:dmarc@hardened.test; adkim=s; aspf=s"
        ]
      },
      "s2048._domainkey.hardened.test": {
        "TXT": [
          "v=DKIM1; k=rsa; "
        ]
      },
      "_mta-sts.hardened.test": {
        "TXT": [
          "v=STSv1; id=20260901"
        ]
      },
      "_smtp._tls.hardened.test": {
        "TXT": [
          "v=TLSRPTv1; rua=mailto:tls-reports@hardened.test"
        ]
      }
    },
    "http": {
      "https://mta-sts.hardened.test/.well-known/mta-sts.txt": "version: STSv1\r\nmode: enforce\r\nmx: mx1.hardened.test\r\nmax_age: 604800\r\n"
    },
    "expected": {
      "grade": "A",
      "score": 100,
      "statuses": {
        "mx": "pass",
        "spf": "pass",
        "dkim": "pass",
        "dmarc": "pass",
        "mta_sts": "pass",
        "tls_rpt": "pass",
        "transport": "pass"
      },
      "not_assessed": [],
      "exposure": {
        "direct-spoofing": "mitigated",
        "subdomain-spoofing": "mitigated",
        "envelope-spoofing": "mitigated",
        "unsigned-mail": "mitigated",
        "tls-downgrade": "mitigated",
        "plaintext-interception": "mitigated",
        "undetected-abuse": "mitigated"
      },
      "one_fix": null
    }
  },
  "cloud_restricted": {
    "domain": "cloud.test",
    "dkim_selectors": [
      "s2048"
    ],
    "smtp": "port25_blocked",
    "zone": {
      "cloud.test": {
        "MX": [
          "10 mx1.cloud.test"
        ],
        "TXT": [
          "v=spf1 ip4:192.0.2.10 -all"
        ]
      },
      "_dmarc.cloud.test": {
        "TXT": [
          "v=DMARC1; p=reject; rua=mailto:dmarc@cloud.test; adkim=s; aspf=s"
        ]
      },
      "s2048._domainkey.cloud.test": {
        "TXT": [
          "v=DKIM1; k=rsa; "
        ]
      },
      "_mta-sts.cloud.test": {
        "TXT": [
          "v=STSv1; id=20260901"
        ]
      },
      "_smtp._tls.cloud.test": {
        "TXT": [
          "v=TLSRPTv1; rua=mailto:tls-reports@cloud.test"
        ]
      }
    },
    "http": {
      "https://mta-sts.cloud.test/.well-known/mta-sts.txt": "version: STSv1\r\nmode: enforce\r\nmx: mx1.cloud.test\r\nmax_age: 604800\r\n"
    },
    "expected": {
      "grade": "A",
      "score": 100,
      "statuses": {
        "mx": "pass",
        "spf": "pass",
        "dkim": "pass",
        "dmarc": "pass",
        "mta_sts": "pass",
        "tls_rpt": "pass",
        "transport": "not_assessed"
      },
      "not_assessed": [
        "transport"
      ],
      "exposure": {
        "direct-spoofing": "mitigated",
        "subdomain-spoofing": "mitigated",
        "envelope-spoofing": "mitigated",
        "unsigned-mail": "mitigated",
        "tls-downgrade": "mitigated",
        "plaintext-interception": "unknown",
        "undetected-abuse": "mitigated"
      },
      "one_fix": null
    }
  }
}