# All optional; defaults shown. Read by backend/app/config.py.
DNS_TIMEOUT=4
SMTP_TIMEOUT=8
HTTP_TIMEOUT=5
SPF_WALK_BUDGET=10
PROBE_BUDGET=20
SCAN_TIMEOUT=30
EHLO_HOSTNAME=scanner.securemailscope.local
# Comma-separated origins allowed to call the API cross-origin (dev: Vite on 5173).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Leave false in production: stops the scanner probing private/loopback IPs (SSRF guard).
ALLOW_PRIVATE_TARGETS=false
# Scan cache (SQLite) backing /api/v1/scan caching and /api/v1/recent.
CACHE_PATH=backend/data/scans.sqlite3
CACHE_TTL=900

# --- Abuse protection (per client IP, in-process: keep one Uvicorn worker) ---
API_RATE_PER_MINUTE=120
API_BURST=60
# New live scans (DNS + port-25 SMTP + HTTPS). Cache hits and demo domains are not counted.
SCAN_RATE_PER_MINUTE=10
SCAN_BURST=8
MAX_CONCURRENT_SCANS=8
SCAN_QUEUE_TIMEOUT=20
# Trust X-Forwarded-For only from this proxy address (Docker image default: 127.0.0.1).
FORWARDED_ALLOW_IPS=127.0.0.1

# --- Claude narratives (optional) ---
# ANTHROPIC_API_KEY=sk-ant-...
LLM_PROVIDER=auto          # auto | anthropic | none
LLM_MODEL=claude-opus-5
LLM_TIMEOUT=90
LLM_FALLBACKS=true         # server-side refusal fallback (beta server-side-fallback-2026-07-01)
LLM_DAILY_BUDGET=300       # Claude calls per UTC day; 0 = unlimited

# --- Logging ---
LOG_LEVEL=INFO
LOG_FORMAT=text            # text | json
