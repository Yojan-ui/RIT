SMS_ENV=development
SMS_LOG_LEVEL=INFO
SMS_CACHE_PATH=data/cache.sqlite3
SMS_CACHE_TTL_SECONDS=3600

# DNS: auto = UDP 53 with DoH fallback when UDP is blocked; udp or doh force one transport.
SMS_DNS_MODE=auto
SMS_DNS_TIMEOUT_SECONDS=5.0
SMS_DNS_NAMESERVERS=
SMS_DOH_ENDPOINTS=https://cloudflare-dns.com/dns-query,https://dns.google/dns-query
# Per-domain token bucket applied to DNS queries.
SMS_DNS_RATE_PER_SECOND=20
SMS_DNS_BURST=40

SMS_HTTP_TIMEOUT_SECONDS=8.0

# SMTP STARTTLS probe. Disable where outbound port 25 is known to be blocked.
SMS_SMTP_PROBE_ENABLED=true
SMS_SMTP_PORT=25
SMS_SMTP_TIMEOUT_SECONDS=15.0
SMS_SMTP_HELO_NAME=securemailscope.invalid
SMS_SMTP_MAX_MX_ATTEMPTS=2
SMS_SMTP_EGRESS_PROBE_HOST=gmail-smtp-in.l.google.com
