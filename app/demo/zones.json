{
  "_comment": "Built-in demo domains (RFC 2606 .example names, never real). Scanned with no network: DNS, the MTA-STS policy and the STARTTLS probe all come from here. 'smtp' is tls13 (modern TLS, valid certificate) or no_starttls. Grades are for the server edition; the browser edition cannot measure STARTTLS and excludes it.",
  "hardened.example": {
    "grade": "A",
    "title": "Fully hardened",
    "story": "Every control in place and enforcing. A clean domain scores 100, with nothing invented to fix.",
    "smtp": "tls13",
    "zone": {
      "hardened.example": {
        "MX": [
          "10 mx1.hardened.example"
        ],
        "TXT": [
          "v=spf1 ip4:192.0.2.0/24 -all"
        ]
      },
      "_dmarc.hardened.example": {
        "TXT": [
          "v=DMARC1; p=reject; rua=mailto:dmarc@hardened.example; adkim=s; aspf=s"
        ]
      },
      "selector1._domainkey.hardened.example": {
        "TXT": [
          "v=DKIM1; k=rsa; "
        ]
      },
      "_mta-sts.hardened.example": {
        "TXT": [
          "v=STSv1; id=20260901"
        ]
      },
      "_smtp._tls.hardened.example": {
        "TXT": [
          "v=TLSRPTv1; rua=mailto:tls-reports@hardened.example"
        ]
      }
    },
    "http": {
      "https://mta-sts.hardened.example/.well-known/mta-sts.txt": "version: STSv1\r\nmode: enforce\r\nmx: mx1.hardened.example\r\nmax_age: 604800\r\n"
    }
  },
  "rollout.example": {
    "grade": "B",
    "title": "Mid-rollout",
    "story": "Mostly protected, with the loose ends of a rollout: SPF ~all, a 1024-bit DKIM key, MTA-STS still in testing and no TLS reporting.",
    "smtp": "tls13",
    "zone": {
      "rollout.example": {
        "MX": [
          "10 mx1.rollout.example"
        ],
        "TXT": [
          "v=spf1 ip4:192.0.2.0/24 ~all"
        ]
      },
      "_dmarc.rollout.example": {
        "TXT": [
          "v=DMARC1; p=quarantine; rua=mailto:dmarc@rollout.example"
        ]
      },
      "selector1._domainkey.rollout.example": {
        "TXT": [
          "v=DKIM1; k=rsa; p=MIGfMA0GCSqGSIb3DQEBAQUAA4GNADCBiQKBgQDX23viiE4sJ4+dObBzBO1jgT+rtrM3E/qdfCZAt7WS8m3Cz1bThPToHLiE0uZhexllLvjxAGotvXPJq/2LxEkTDFV1aU/NrgMhPzdIRxkFFdLotgzrUO669aZk7AxMRwf7QSKdwcC0fb3CdjDbl0FsKma5Hit15yDA6nYNfK0DOwIDAQAB"
        ]
      },
      "_mta-sts.rollout.example": {
        "TXT": [
          "v=STSv1; id=20260901"
        ]
      }
    },
    "http": {
      "https://mta-sts.rollout.example/.well-known/mta-sts.txt": "version: STSv1\r\nmode: testing\r\nmx: mx1.rollout.example\r\nmax_age: 604800\r\n"
    }
  },
  "monitor-only.example": {
    "grade": "C",
    "title": "Monitor-only DMARC",
    "story": "Everything is right except DMARC is stuck at p=none, so spoofed mail is still delivered. One setting away from an A.",
    "smtp": "tls13",
    "zone": {
      "monitor-only.example": {
        "MX": [
          "10 mx1.monitor-only.example"
        ],
        "TXT": [
          "v=spf1 ip4:192.0.2.0/24 -all"
        ]
      },
      "_dmarc.monitor-only.example": {
        "TXT": [
          "v=DMARC1; p=none; rua=mailto:dmarc@monitor-only.example"
        ]
      },
      "selector1._domainkey.monitor-only.example": {
        "TXT": [
          "v=DKIM1; k=rsa; "
        ]
      },
      "_mta-sts.monitor-only.example": {
        "TXT": [
          "v=STSv1; id=20260901"
        ]
      },
      "_smtp._tls.monitor-only.example": {
        "TXT": [
          "v=TLSRPTv1; rua=mailto:tls-reports@monitor-only.example"
        ]
      }
    },
    "http": {
      "https://mta-sts.monitor-only.example/.well-known/mta-sts.txt": "version: STSv1\r\nmode: enforce\r\nmx: mx1.monitor-only.example\r\nmax_age: 604800\r\n"
    }
  },
  "no-dmarc.example": {
    "grade": "D",
    "title": "No DMARC",
    "story": "SPF, DKIM and STARTTLS are fine, but with no DMARC record nothing tells receivers to reject forged mail.",
    "smtp": "tls13",
    "zone": {
      "no-dmarc.example": {
        "MX": [
          "10 mx1.no-dmarc.example"
        ],
        "TXT": [
          "v=spf1 ip4:192.0.2.0/24 -all"
        ]
      },
      "selector1._domainkey.no-dmarc.example": {
        "TXT": [
          "v=DKIM1; k=rsa; "
        ]
      }
    },
    "http": {}
  },
  "unprotected.example": {
    "grade": "F",
    "title": "Unprotected",
    "story": "A mail server and nothing else: no SPF, DKIM, DMARC or MTA-STS, and no encryption on inbound mail.",
    "smtp": "no_starttls",
    "zone": {
      "unprotected.example": {
        "MX": [
          "10 mx1.unprotected.example"
        ],
        "TXT": [
